# MediMind configuration template.
# Copy to .env (git-ignored) and adjust. Real environment variables override values in .env.
# Never put real secrets in this file: it is committed to git.

# development | test | production
MEDIMIND_APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
MEDIMIND_LOG_LEVEL=INFO

# text (human-readable) | json (one JSON object per line)
MEDIMIND_LOG_FORMAT=text

# Required application data directory. data/synthetic inside it holds optional demo data.
MEDIMIND_DATA_DIR=data

# --- PostgreSQL (Docker Compose) ---------------------------------------------------------------
# docker-compose.yml reads these same variables from .env.
# Use 127.0.0.1 (not "localhost"): the database port is bound to IPv4 loopback only.
MEDIMIND_DB_HOST=127.0.0.1
# Host port. Change it if 5432 is already used by another PostgreSQL on this machine.
MEDIMIND_DB_PORT=5432
MEDIMIND_DB_NAME=medimind
MEDIMIND_DB_USER=medimind
# REQUIRED before `docker compose up`: set a strong, unique password in your own .env.
# It is intentionally empty here: Docker Compose refuses to start the database while it is empty.
# Never commit a real password, and never put one in this file.
MEDIMIND_DB_PASSWORD=

# --- Document ingestion (Phase 2) ---------------------------------------------------------------
# Uploads larger than this are rejected before parsing (bytes; 20971520 = 20 MB).
MEDIMIND_MAX_UPLOAD_BYTES=20971520
# PDFs with more pages are rejected. About 10 s/page native, 20 s/page scanned (CPU, Task 2.1).
MEDIMIND_MAX_PAGES=20
# Docling stops parsing one document after this many seconds; the document is marked failed.
MEDIMIND_PARSE_TIMEOUT_SECONDS=600

# --- Evidence retrieval (Milestone R1, ADR-035) -------------------------------------------------
# Pinned model commits (40 hex characters). Empty until the owner approves the exact revisions;
# indexing and search refuse to run without them, and no model is ever downloaded automatically.
MEDIMIND_EMBEDDING_MODEL_REVISION=
MEDIMIND_RERANKER_MODEL_REVISION=
# Reciprocal Rank Fusion constant, candidates per retriever, reranked candidates, pages returned.
MEDIMIND_RETRIEVAL_RRF_K=60
MEDIMIND_RETRIEVAL_CANDIDATES=50
MEDIMIND_RETRIEVAL_RERANK_TOP=20
MEDIMIND_RETRIEVAL_TOP_K=5
# Abstain below this reranker score. Empty = not calibrated (calibrate on the dev split only).
MEDIMIND_RETRIEVAL_ABSTAIN_THRESHOLD=

# --- Local UI (Task 2.9b, ADR-014) ---------------------------------------------------------------
# true: synthetic patients only, new patients are created synthetic, upload is disabled, and a
# banner says so. Nothing is loaded or created automatically. Default false.
MEDIMIND_DEMO_MODE=false

# --- Copilot (Phase 5, ADR-040) ------------------------------------------------------------------
# Retrieval mode for document passages. Default lexical: the mode frozen by the R1.8 evaluation
# (evals/reports/lab_v0/dev_selection.json). Empty = the best mode whose models are configured.
MEDIMIND_COPILOT_RETRIEVAL_MODE=lexical
# Answer generation: none (deterministic extractive answers, no model) | openai_compatible.
# No LLM provider has been selected or evaluated yet (ADR-024). External endpoints are refused
# unless MEDIMIND_LLM_ALLOW_EXTERNAL=true, and then only for synthetic patients (ADR-005).
MEDIMIND_LLM_PROVIDER=none
# e.g. http://127.0.0.1:11434/v1 for a local Ollama server
MEDIMIND_LLM_BASE_URL=
MEDIMIND_LLM_MODEL=
# Secret: never commit a real key. Only needed by hosted providers.
MEDIMIND_LLM_API_KEY=
MEDIMIND_LLM_ALLOW_EXTERNAL=false
MEDIMIND_LLM_TIMEOUT_SECONDS=60
