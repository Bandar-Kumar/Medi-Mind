# MediMind configuration template.
# Copy to .env (git-ignored) and adjust. Real environment variables override values in .env.
# Never put real secrets in this file: it is committed to git.

# development | test | production
MEDIMIND_APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
MEDIMIND_LOG_LEVEL=INFO

# text (human-readable) | json (one JSON object per line)
MEDIMIND_LOG_FORMAT=text

# Required application data directory. data/synthetic inside it holds optional demo data.
MEDIMIND_DATA_DIR=data

# --- PostgreSQL (Docker Compose) ---------------------------------------------------------------
# docker-compose.yml reads these same variables from .env.
# Use 127.0.0.1 (not "localhost"): the database port is bound to IPv4 loopback only.
MEDIMIND_DB_HOST=127.0.0.1
# Host port. Change it if 5432 is already used by another PostgreSQL on this machine.
MEDIMIND_DB_PORT=5432
MEDIMIND_DB_NAME=medimind
MEDIMIND_DB_USER=medimind
# REQUIRED before `docker compose up`: set a strong, unique password in your own .env.
# It is intentionally empty here: Docker Compose refuses to start the database while it is empty.
# Never commit a real password, and never put one in this file.
MEDIMIND_DB_PASSWORD=
