# MediMind configuration template.
# Copy to .env (git-ignored) and adjust. Real environment variables override values in .env.
# Never put real secrets in this file: it is committed to git.

# development | test | production
MEDIMIND_APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
MEDIMIND_LOG_LEVEL=INFO

# text (human-readable) | json (one JSON object per line)
MEDIMIND_LOG_FORMAT=text

# Required application data directory. data/synthetic inside it holds optional demo data.
MEDIMIND_DATA_DIR=data
